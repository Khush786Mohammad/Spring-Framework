<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
	xmlns:p="http://www.springframework.org/schema/p"
	xmlns:c="http://www.springframework.org/schema/c"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd">

	<bean name="address1" class="com.spring.springcore.springadvanced.autowiring.Address"
		p:houseno="123"
		p:street="Sector"
		p:city="Gandhinagar"
	>
	</bean>
	<bean name="employee" class="com.spring.springcore.springadvanced.autowiring.Employee"
		autowire="byType"
	/>
	<bean name="employee2" class="com.spring.springcore.springadvanced.autowiring.Employee"
		autowire="byName"
	/>
	<bean name="employee3" class="com.spring.springcore.springadvanced.autowiring.Employee"
		autowire="constructor"
	/>
	
	<context:annotation-config></context:annotation-config>
</beans>